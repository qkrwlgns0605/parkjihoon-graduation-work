  "main": "index.js",
  "scripts": {
    "start": "nodemon -L --exec ts-node -r tsconfig-paths/register src/index.ts --max-old-space-size=4096",
    "tsc": "tsc",
    "start:prod": "ts-node -r tsconfig-paths/register src/bin/server.ts",
    "db:drop": "sequelize-cli db:drop",
    "db:create": "ts-node -r tsconfig-paths/register src/utils/makeMigration",
    "db:init": "sequelize-cli db:create",
    "db:migrate": "sequelize-cli db:migrate",
    "db:migrate:undo": "sequelize-cli db:migrate:undo",
    "db:reset": "sequelize-cli db:drop && sequelize-cli db:create && npm run db:migrate",
    "db:seed": "sequelize-cli db:seed:all"
  },
